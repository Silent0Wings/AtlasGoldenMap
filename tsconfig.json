{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"]
  },
  "include": ["atlas.config.ts", "atlas.config.demo.ts", "playwright.config.ts", "core/**/*.ts", "examples/**/*.ts"]
}
